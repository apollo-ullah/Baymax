# Baymax agent network — environment template.
# Copy to `.env` and fill locally. TESTNET ONLY. Never put real secrets here,
# never commit the filled-in `.env` (it is gitignored).

# --- uAgents identity seeds -------------------------------------------------
# Each agent needs its own stable, secret seed phrase so its address is
# deterministic across restarts. Generate unique phrases locally.
BAYMAX_FRONT_SEED=change-me-unique-phrase-front-agent
BAYMAX_HOSP_B_SEED=change-me-unique-phrase-hospital-b
BAYMAX_HOSP_C_SEED=change-me-unique-phrase-hospital-c
# Phase 0 hello agent (kept for reference)
AGENT_SEED_PHRASE=change-me-unique-phrase-hello-agent

# --- Fetch network ----------------------------------------------------------
# TESTNET ONLY. Do not point this at mainnet. Payment Protocol runs on the
# auto-funded testnet; no real funds are ever touched.
FETCH_NETWORK=testnet

# --- Seam: offer ranking (Claude) — Workstream B ----------------------------
# Only needed once the rank_offers() mock in interfaces.py is swapped for real
# Claude reasoning. The Wave 0 mock allocator needs no key.
ANTHROPIC_API_KEY=

# --- Camera / vision demo (desk props as medical inventory) -----------------
# BAYMAX_VISION_DEMO=1  count water bottles & similar props as BAYMAX_ITEM (default on in single_mac_demo.sh)
# BAYMAX_ITEM=Saline    label written to Redis + sent to agents
# BAYMAX_VISION_HINT=   optional extra hint for the vision prompt
# BAYMAX_DEMO_CAPACITY=3
# BAYMAX_DEMO_TARGET=3    Hospital A: need this many on hand (vision sees 2 → shortfall 1)
# BAYMAX_DEMO_RESERVE=1   Hospital B: keep this many safe (vision sees 2 → spare 1)

# --- Seam: inventory state (Redis) — Workstream C ---------------------------
# Only needed once the get_inventory() mock in interfaces.py is swapped for
# real Redis. The Wave 0 mock needs no Redis.
REDIS_URL=

# --- Tailscale (two-MacBook demo when WiFi blocks peer ports) ---------------
# Install Tailscale on both MacBooks, join the same tailnet, then:
#   tailscale set --hostname=baymax-a   # MacBook A (server)
#   tailscale set --hostname=baymax-b   # MacBook B (camera worker)
# Set BAYMAX_USE_TAILSCALE=1 on BOTH machines; camera_worker / scan_dashboard
# auto-fill REDIS_URL and WORKER_* from the hostnames below (or use 100.x IPs).
BAYMAX_USE_TAILSCALE=
TAILSCALE_SERVER=baymax-a
TAILSCALE_PEER_B=baymax-b

# --- Settlement: Payment Protocol (Stream PAY) ------------------------------
# FET charged per inter-facility transfer settlement (flat fallback; testnet FET).
BAYMAX_PAYMENT_AMOUNT_FET=0.1
# Optional per-unit pricing: if set, a settlement is charged
# per_unit * (units transferred), overriding the flat amount above.
BAYMAX_PAYMENT_PER_UNIT_FET=
# Seconds the user has to approve + sign before the payment request expires.
BAYMAX_PAYMENT_DEADLINE_S=300
# On-chain verification of the committed tx via cosmpy on the FET testnet.
#   true  (default) -> query the chain; CompletePayment only on a successful tx.
#   false           -> SKIP the chain query and trust the commit. DEV/SPIKE ONLY
#                      (used by two_agent_payment_spike.py for the green path);
#                      NOT a real settlement guarantee. Never set false in prod.
PAYMENT_VERIFY_ONCHAIN=true
