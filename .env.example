# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

# --- Anthropic (Claude reasoning + vision) ---
ANTHROPIC_API_KEY=

# --- Redis (state + pub/sub integration seam) ---
REDIS_URL=redis://localhost:6379

# --- Weather agent location (Open-Meteo needs NO key) ---
WEATHER_LATITUDE=37.8716
WEATHER_LONGITUDE=-122.2727

# --- Forecast region (must match the Redis track's seeded region) ---
FORECAST_REGION=san_francisco

# --- Fetch.ai (agent seeds / Agentverse) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEATHER_AGENT_SEED=
ILLNESS_AGENT_SEED=
