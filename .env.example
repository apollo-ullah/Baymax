# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

# --- Anthropic (Claude reasoning + vision) ---
ANTHROPIC_API_KEY=

# --- Redis (state + pub/sub integration seam) ---
REDIS_URL=redis://localhost:6379

# --- Weather agent location (Open-Meteo needs NO key) ---
WEATHER_LATITUDE=37.8716
WEATHER_LONGITUDE=-122.2727

# --- Forecast region (must match the Redis track's seeded region) ---
FORECAST_REGION=san_francisco

# --- Fetch.ai (agent seeds / Agentverse) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEATHER_AGENT_SEED=
ILLNESS_AGENT_SEED=

# --- Poke (iMessage notifications — FR15, P2 bonus) ---
# V2 API key from https://poke.com/kitchen -> API Keys -> Add API Key
POKE_API_KEY=
# Optional per-doctor keys for a two-phone demo (fall back to POKE_API_KEY):
POKE_API_KEY_HOSPITAL_A=
POKE_API_KEY_HOSPITAL_B=

# --- Approval service (Hospital A <-> B human approval flow) ---
APPROVAL_BASE_URL=http://localhost:8080
